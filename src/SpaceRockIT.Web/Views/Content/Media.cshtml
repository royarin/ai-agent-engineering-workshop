@{ ViewData["Title"] = L["Nav.Media"].Value; }

<div class="page-header">
    <div class="container"><h1>@L["Nav.Media"]</h1></div>
</div>

<section class="content-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <h2 class="section-title">@L["Media.Video"]</h2>
                <div class="panel text-center mb-5">
                    <p class="prose">@L["Media.VideoIntro"]</p>
                    <a class="btn-brand" href="https://www.spacerockitfestival.nl/media/" target="_blank" rel="noopener">@L["Media.VideoBtn"]</a>
                </div>

                <h2 class="section-title">@L["Media.Photos"]</h2>
                <div class="panel text-center">
                    <p class="prose">@L["Media.PhotosIntro"]</p>
                    <p class="prose mb-4">@L["Media.PhotosNote"]</p>
                    <a class="btn-brand-outline" href="https://www.spacerockitfestival.nl/media/" target="_blank" rel="noopener">@L["Media.PhotosBtn"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

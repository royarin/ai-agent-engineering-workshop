@{ ViewData["Title"] = L["Sponsor.Contact.Title"].Value; }

<div class="page-header">
    <div class="container"><h1>@L["Footer.Sponsor.Title"]</h1></div>
</div>

<section class="content-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="prose text-center mb-5" style="max-width:820px;margin:0 auto">
                    <p>@L["Sponsor.Intro1"]</p>
                    <p>@L["Sponsor.Intro2"]</p>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <div class="panel h-100">
                            <h3 style="color:var(--accent)">Jedi Master</h3>
                            <ul class="prose">
                                <li>@L["Sponsor.Master.B1"]</li>
                                <li>@L["Sponsor.Master.B2"]</li>
                                <li>@L["Sponsor.Bullet.Opening"]</li>
                                <li>@L["Sponsor.Master.Tickets"]</li>
                                <li>@L["Sponsor.Bullet.Web"]</li>
                                <li>@L["Sponsor.Bullet.Shirt"]</li>
                                <li>@L["Sponsor.Bullet.Goodie"]</li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="panel h-100">
                            <h3 style="color:var(--accent)">Jedi Knight</h3>
                            <ul class="prose">
                                <li>@L["Sponsor.Knight.B1"]</li>
                                <li>@L["Sponsor.Bullet.Opening"]</li>
                                <li>@L["Sponsor.Knight.Tickets"]</li>
                                <li>@L["Sponsor.Bullet.Web"]</li>
                                <li>@L["Sponsor.Bullet.Shirt"]</li>
                                <li>@L["Sponsor.Bullet.Goodie"]</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="panel text-center">
                    <h2 class="h4" style="color:var(--white)">@L["Sponsor.Contact.Title"]</h2>
                    <p class="prose">@L["Sponsor.Contact.Body"] <a href="mailto:info@spacerockitfestival.nl">info@spacerockitfestival.nl</a></p>
                    <a class="btn-brand" href="mailto:info@spacerockitfestival.nl?subject=Sponsor%20SpaceRockIT">@L["Sponsor.Contact.Btn"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

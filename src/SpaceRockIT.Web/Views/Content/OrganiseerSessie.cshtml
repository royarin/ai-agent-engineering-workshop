@{ ViewData["Title"] = L["Organise.Title"].Value; }

<div class="page-header">
    <div class="container"><h1>@L["Organise.Title"]</h1></div>
</div>

<section class="content-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="prose">
                    <p>@L["Organise.Intro"]</p>
                    <ul>
                        <li>@L["Organise.B1.Before"] <a href="/sponsor-worden-ja-graag">@L["Organise.B1.Link"]</a>.</li>
                        <li>@L["Organise.B2"] <a href="mailto:Sprekers@spacerockitfestival.nl">Sprekers@spacerockitfestival.nl</a>.</li>
                        <li>@L["Organise.B3"] <a href="mailto:Francis@spacerockitfestival.nl">Francis@spacerockitfestival.nl</a>.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

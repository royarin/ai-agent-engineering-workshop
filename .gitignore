# .NET
bin/
obj/
*.user
[Dd]ebug/
[Rr]elease/

# Local databases (generated + seeded on first run)
*.db
*.db-shm
*.db-wal

# Scaffolded client libs we do not use — the site ships hand-written CSS (wwwroot/css/site.css)
# and no JS framework. Kept out so a clean clone stays small on a festival connection.
src/SpaceRockIT.Web/wwwroot/lib/

# Visual Studio / Rider local state
.vs/
.idea/
*.suo

# Local MCP credentials and overrides must never be committed.
.env
.env.*
!.env.example
.vscode/mcp.local.json

# Fidelity screenshots: regenerated by _agent-scratch/fidelity.py, ~2 MB per run and meaningless
# once re-measured. The scores themselves (results/fidelity.json) are small and worth keeping.
# The whole _agent-scratch folder is disposable — nothing depends on it.
_agent-scratch/results/*.png

# Python bytecode from the mining tools
__pycache__/
*.pyc
